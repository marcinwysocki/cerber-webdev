  "components": {
    "schemas": {
      "Error": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Error"
      },
      "GPSFix": {
        "properties": {
          "time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time",
            "description": "Czas fixu z odbiornika, UTC"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude",
            "description": "Szerokosc [deg]"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude",
            "description": "Dlugosc [deg]"
          },
          "altitude": {
            "type": "number",
            "title": "Altitude",
            "description": "Wysokosc [m n.p.m.]"
          },
          "satellites": {
            "type": "integer",
            "maximum": 255.0,
            "minimum": 0.0,
            "title": "Satellites"
          },
          "fix_quality": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Fix Quality",
            "description": "NMEA GGA: 0 brak fixu, 1 GPS, 2 DGPS, 4 RTK fix, 5 RTK float"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "altitude",
          "satellites",
          "fix_quality"
        ],
        "title": "GPSFix",
        "description": "Z MQTT cerber/gps/data."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "1.0.0"
          },
          "rosbridge_connected": {
            "type": "boolean",
            "title": "Rosbridge Connected"
          },
          "mqtt_connected": {
            "type": "boolean",
            "title": "Mqtt Connected"
          },
          "ts": {
            "type": "number",
            "title": "Ts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "rosbridge_connected",
          "mqtt_connected",
          "ts"
        ],
        "title": "Health"
      },
      "Imu": {
        "properties": {
          "orientation": {
            "$ref": "#/components/schemas/Quaternion",
            "description": "Orientacja z IMU (kwaternion z RPY motion hosta), frame_id=base_link"
          },
          "roll": {
            "type": "number",
            "title": "Roll",
            "description": "Przechyl [rad], wyliczony z orientation"
          },
          "pitch": {
            "type": "number",
            "title": "Pitch",
            "description": "Pochylenie [rad]"
          },
          "yaw": {
            "type": "number",
            "title": "Yaw",
            "description": "Odchylenie [rad]"
          },
          "angular_velocity": {
            "$ref": "#/components/schemas/Vec3",
            "description": "Predkosc katowa; rad/s wg konwencji sensor_msgs/Imu - stockowy node przekazuje surowe wartosci z UDP bez konwersji, jednostka do potwierdzenia na robocie"
          },
          "linear_acceleration": {
            "$ref": "#/components/schemas/Vec3",
            "description": "Przyspieszenie liniowe; m/s^2 wg konwencji sensor_msgs/Imu, surowe z UDP, do potwierdzenia"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "orientation",
          "roll",
          "pitch",
          "yaw",
          "angular_velocity",
          "linear_acceleration"
        ],
        "title": "Imu",
        "description": "Z /imu/data (sensor_msgs/Imu)."
      },
      "Joints": {
        "properties": {
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 12,
            "title": "Names",
            "description": "Stala kolejnosc ze stocku Lite3: LF_Joint, LF_Joint_1, LF_Joint_2, RF_Joint, RF_Joint_1, RF_Joint_2, LB_Joint, LB_Joint_1, LB_Joint_2, RB_Joint, RB_Joint_1, RB_Joint_2"
          },
          "position": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 12,
            "title": "Position",
            "description": "Kat stawu; rad wg konwencji sensor_msgs/JointState (stock nie konwertuje, znak odwrocony wzgledem UDP)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "names",
          "position"
        ],
        "title": "Joints",
        "description": "Z /joint_states (sensor_msgs/JointState). 12 stawow w stalej kolejnosci."
      },
      "Odometry": {
        "properties": {
          "position": {
            "$ref": "#/components/schemas/Vec3",
            "description": "Pozycja w ukladzie odom [m]"
          },
          "yaw": {
            "type": "number",
            "title": "Yaw",
            "description": "Kurs [rad]"
          },
          "velocity_body": {
            "$ref": "#/components/schemas/Vec3",
            "description": "Predkosc w ukladzie ciala: x do przodu, y w lewo (vel_body ze stocku, m/s wg konwencji); z = 0"
          },
          "yaw_rate": {
            "type": "number",
            "title": "Yaw Rate",
            "description": "Predkosc obrotu (rpy_vel[2] ze stocku, rad/s wg konwencji)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "position",
          "yaw",
          "velocity_body",
          "yaw_rate"
        ],
        "title": "Odometry",
        "description": "Z /leg_odom2 (nav_msgs/Odometry) - odometria z nog, uklad 'odom'."
      },
      "Ptz": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/PtzState"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state"
        ],
        "title": "Ptz",
        "description": "Z /ptz/status (std_msgs/String), zdekodowany. IP glowicy (adres w sieci\nrobota) jest pomijane - nie wystawiamy go publicznie."
      },
      "PtzState": {
        "type": "string",
        "enum": [
          "MOVING",
          "WAITING",
          "DISCONNECTED",
          "UNKNOWN"
        ],
        "title": "PtzState"
      },
      "Quaternion": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          },
          "z": {
            "type": "number",
            "title": "Z"
          },
          "w": {
            "type": "number",
            "title": "W"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x",
          "y",
          "z",
          "w"
        ],
        "title": "Quaternion"
      },
      "RobotList": {
        "properties": {
          "robots": {
            "items": {
              "$ref": "#/components/schemas/RobotSummary"
            },
            "type": "array",
            "title": "Robots"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "robots"
        ],
        "title": "RobotList"
      },
      "RobotStatus": {
        "properties": {
          "online": {
            "type": "boolean",
            "title": "Online",
            "description": "rosbridge polaczony i ostatnia wiadomosc ROS w ciagu STALE_AFTER_S (domyslnie 5 s); GPS/MQTT sie nie liczy"
          },
          "last_seen": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen",
            "description": "epoch [s] ostatniej wiadomosci ROS; null, dopoki zadna nie przyszla"
          },
          "rosbridge_connected": {
            "type": "boolean",
            "title": "Rosbridge Connected",
            "description": "WebSocket do rosbridge otwarty"
          },
          "mqtt_connected": {
            "type": "boolean",
            "title": "Mqtt Connected",
            "description": "Polaczenie z brokerem MQTT (GPS)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "online",
          "last_seen",
          "rosbridge_connected",
          "mqtt_connected"
        ],
        "title": "RobotStatus",
        "description": "Stan robota i polaczen gatewaya. Na WS jako zdarzenie `status`: od razu przy zmianie\nonline / rosbridge_connected / mqtt_connected i jako heartbeat co WS_HEARTBEAT_S (domyslnie 5 s)."
      },
      "RobotSummary": {
        "properties": {
          "robot_id": {
            "type": "string",
            "title": "Robot Id"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "examples": [
              "DEEP Robotics Lite3 Venture"
            ]
          },
          "online": {
            "type": "boolean",
            "title": "Online",
            "description": "True, gdy rosbridge polaczony i ostatnia wiadomosc ROS przyszla w ciagu STALE_AFTER_S; GPS/MQTT sie nie liczy"
          },
          "last_seen": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen",
            "description": "epoch [s] ostatniej wiadomosci ROS"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "robot_id",
          "model",
          "online"
        ],
        "title": "RobotSummary"
      },
      "SensorsAlive": {
        "properties": {
          "imu": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imu"
          },
          "odom": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Odom"
          },
          "joints": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Joints"
          },
          "realsense": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Realsense"
          },
          "lidar": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lidar"
          },
          "ultrasound": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ultrasound"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SensorsAlive",
        "description": "Z /sensor_status/*_isalive (std_msgs/Bool)."
      },
      "TelemetrySnapshot": {
        "properties": {
          "robot_id": {
            "type": "string",
            "title": "Robot Id",
            "examples": [
              "cerber-lite3-01"
            ]
          },
          "ts": {
            "type": "number",
            "title": "Ts",
            "description": "Czas zlozenia snapshotu, epoch [s] wg zegara gatewaya"
          },
          "imu": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Imu"
              },
              {
                "type": "null"
              }
            ]
          },
          "imu_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imu At",
            "description": "epoch [s] odbioru ostatniego /imu/data"
          },
          "joints": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Joints"
              },
              {
                "type": "null"
              }
            ]
          },
          "joints_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Joints At"
          },
          "odometry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Odometry"
              },
              {
                "type": "null"
              }
            ]
          },
          "odometry_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Odometry At"
          },
          "ultrasound": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ultrasound",
            "description": "Element [1] tablicy ultrasound[2] z RobotState (stock publikuje tylko ten); ktory czujnik i jednostka - do potwierdzenia na robocie"
          },
          "ultrasound_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ultrasound At"
          },
          "ptz": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Ptz"
              },
              {
                "type": "null"
              }
            ]
          },
          "ptz_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ptz At"
          },
          "gps": {
            "anyOf": [
